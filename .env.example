# free-claude-code proxy
# Use `http://localhost:8082` when running natively,
# or `http://host.docker.internal:8082` from inside a Docker container.
FREE_CLAUDE_BASE_URL=http://localhost:8082
FREE_CLAUDE_AUTH_TOKEN=freecc
FREE_CLAUDE_DEFAULT_MODEL=nvidia_nim/z-ai/glm4.7
FREE_CLAUDE_TIMEOUT_SECONDS=120
FREE_CLAUDE_STREAMING_ENABLED=true

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# leave empty to use long polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_GUEST_MODE_ENABLED=true
# Optional comma-separated chat IDs whitelist (e.g. "192802079,-1001234567890").
# Leave empty to allow all chats.
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional comma-separated chat IDs allowed to run admin commands.
# Diagnostics like /webhook fall back to TELEGRAM_ALLOWED_CHAT_IDS when this is
# empty; destructive lifecycle commands like /logout and /close require this
# list and do not fall back. If both lists are empty, admin commands are
# disabled.
TELEGRAM_ADMIN_CHAT_IDS=
# Show a "typing…" chat action while Claude/proxy handles a request.
# Set to false to keep the chat silent during processing.
TELEGRAM_CHAT_ACTION_ENABLED=true

# Security
# Required when webhook mode is used.
API_SECRET_TOKEN=your_webhook_secret_token
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
